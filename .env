# Meltic Healthcare - Environment Variables Template
# Copy this file to .env for local development
# DO NOT commit .env files with actual values to git

# API Configuration
EXPO_PUBLIC_WC_BASE_URL=https://www.melticgroup.com/online
EXPO_PUBLIC_API_URL=https://www.melticgroup.com/online/wp-json/app/v1

# App Environment (development, staging, production)
EXPO_PUBLIC_APP_ENV=development

# Note: Sensitive credentials (WooCommerce consumer key/secret) should NEVER
# be stored in environment variables on the client side. These must be handled
# server-side through authenticated API endpoints.
